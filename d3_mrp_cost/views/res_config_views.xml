<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_mrp" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mrp.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='mrp']//block[@name='process_operations_setting_container']" position="inside">
                
                <setting id="operation_cost" string="Active Operation Costs" invisible="not group_mrp_routings" help="Create an accounting entry for operation costs">
                    <field name="work_center_cost" />
                </setting>

            </xpath>
        </field>
    </record>
</odoo>