<odoo>
	
	<record id="res_config_settings_view_form" model="ir.ui.view">
		<field name="name">res.config.settings.view.form.inherit.d3system</field>
		<field name="model">res.config.settings</field>
		<field name="inherit_id" ref="base.res_config_settings_view_form"/>
		<field name="arch" type="xml">
			<xpath expr="//form" position="inside">
				<app name="d3_system_code" string="D3 System Settings" icon="/d3_system_code/static/description/icon.png">
					<block title="MRP Cost" name="mrp_cost_settings">
						<setting id="module_d3_mrp_cost-cost" string="Install MRP Cost" help="Creates accounting entries for the additional operation costs in manufacturing orders.">
							<field name="module_d3_mrp_cost" />
						</setting>
					</block>
					<block title="Product image" name="product_image_settings">
						<setting id="module_d3_product_image" string="Install Product Image" help="Adds product images to sales PDFs and customer portal views. " >
							<field name="module_d3_product_image" />
						</setting>
					</block>				
					<block title="Website Price" name="website_price_settings">
						<setting id="module_d3_website_price" string="Install Website Price" help="Hide the sale price of specific products in the website interface.">
							<field name="module_d3_website_price" />
						</setting>
					</block>
					<block title="Website Rebranding" name="website_rebranding_settings">
						<setting id="module_d3_wesbite_rebranding" string="Install Website Rebranding" help="Replacing the default branding with a custom brand on the website and email templates" >
							<field name="module_d3_wesbite_rebranding" />
						</setting>
					</block>
					<block title="Helpdesk User" name="helpdesk_user_settings">
						<setting id="module_helpdesk_user" string="Install Helpdesk User" help="Modifies the Helpdesk module to allow logging time on a ticket by linking it to a task.">
							<field name="module_helpdesk_user" />
						</setting>
					</block>
					<block title="Project User" name="project_user_settings">
						<setting id="module_project_user" string="Install Project User" help="Allows viewing and editing of a specific user's personal task view.">
							<field name="module_project_user" />
						</setting>
					</block>
					<block title="Timesheet User" name="timesheet_user_settings">
						<setting id="module_timesheet_user" string="Install Timesheet User" help=" It allows you to generate and send to the client a weekly report with all the hours reported on a project during the week.">
							<field name="module_timesheet_user"  />
						</setting>
					</block>
					<block title="Customer Statement" name="customer_statement_settings">
						<setting id="module_d3_customer_statement" string="Install Customer Statement" help="Automatically sends customer account statements monthly through a scheduled action.">
							<field name="module_d3_customer_statement" />
						</setting>
					</block>
					
				</app>
				
			</xpath>
		</field>
	</record>
</odoo>
