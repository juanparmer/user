                </sheet>
            </form>
        </field>
    </record>
    <record id="avansat_avansat_action" model="ir.actions.act_window">
        <field name="name">Avansat</field>
        <field name="res_model">avansat.avansat</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>
    <menuitem
        id="avansat_avansat_root"
        name="Avansat"
        sequence="10"/>
    <menuitem
        id="avansat_avansat_menu"
        name="Avansat"
        action="avansat_avansat_action"
        parent="avansat_avansat_root"
        sequence="10"/>
</odoo>