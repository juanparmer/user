                            <field name="contenedor_2"/>
                            <field name="tipo_vinculacion"/>
                            <field name="orden_cargue"/>
                            <field name="remisiones"/>
                            <field name="fecha_remesa"/>
                            <field name="fecha_salida_despacho"/>
                            <field name="fecha_llegada_despacho"/>
                            <field name="cumplida"/>
                            <field name="fecha_llegada_cargue"/>
                            <field name="fecha_salida_cargue"/>
                            <field name="fecha_llegada_descargue"/>
                            <field name="fecha_salida_descargue"/>
                            <field name="factura"/>
                            <field name="fecha_factura"/>
                            <field name="fecha_vencimiento"/>
                            <field name="val_facturado_x_separado"/>
                            <field name="val_facturado_remesa"/>
                            <field name="nombre_ser_especial"/>
                            <field name="aplica_rentabilidad"/>
                            <field name="val_servicios"/>
                            <field name="val_produccion"/>
                            <field name="cantidad_facturada"/>
                            <field name="costo_unitario" />
                            <field name="retefuente_factura" />
