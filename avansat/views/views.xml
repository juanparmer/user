<odoo>
    <record id="avansat_avansat_view_search" model="ir.ui.view">
        <field name="name">avansat.avansat.view.search</field>
        <field name="model">avansat.avansat</field>
        <field name="arch" type="xml">
            <search string="Avansat">
                <field name="manifiesto" />
            </search>
        </field>
    </record>
    <record id="avansat_avansat_view_tree" model="ir.ui.view">
        <field name="name">avansat.avansat.view.tree</field>
        <field name="model">avansat.avansat</field>
        <field name="arch" type="xml">
            <tree string="Avansat">
                <field name="manifiesto" />
                <field name="fecha_manifiesto"/>
                <field name="placa"/>
                <field name="remesa"/>
                <field name="val_inicial_remesa"/>
                <field name="val_declarado_remesa"/>
                <field name="val_ser_esp_rem"/>
                <field name="facturado_a"/>
                <field name="origen"/>
                <field name="destino"/>
                <field name="destinatario"/>
            </tree>
        </field>
    </record>
    <record id="avansat_avansat_view_form" model="ir.ui.view">
        <field name="name">avansat.avansat.view.form</field>
        <field name="model">avansat.avansat</field>
        <field name="arch" type="xml">
            <form string="Avansat">
                <sheet>
                    <group>
                        <group string="verde">
                            <field name="manifiesto"/>
                            <field name="fecha_manifiesto"/>
                            <field name="placa"/>
                            <field name="remesa"/>
                            <field name="val_inicial_remesa"/>
                            <field name="val_declarado_remesa"/>
                            <field name="val_ser_esp_rem"/>
                            <field name="facturado_a"/>
                            <field name="origen"/>
                            <field name="destino"/>
                            <field name="destinatario"/>

                        </group>
                        <group string="azul">
                            <field name="nombre_ser_especial"/>
