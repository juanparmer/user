<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="timesheet_weekly_view_form" model="ir.ui.view">
        <field name="name">timesheet.weekly.view.form</field>
        <field name="model">timesheet.weekly</field>
        <field name="arch" type="xml">
            <form string="Weekly Timesheet">
                <sheet>
                    <group>
                        <group>
                            <field name="email_type" string="Type" />
                            <field name="date_start" />
                            <field name="date_end" />
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" />
                            <field name="project_id" domain="[('timesheet_report','=',True)]" invisible="email_type != 'compose'" required="email_type == 'compose'" />
                            <field name="projects_ids" domain="[('timesheet_report','=',True)]" widget="many2many_tags" invisible="email_type != 'message'" required="email_type == 'message'" />
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Confirm" name="action_confirm" type="object" class="oe_highlight" />
                    <button string="Cancel" class="oe_highlight" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="timesheet_weekly_action" model="ir.actions.act_window">
        <field name="name">Weekly Timesheet</field>
        <field name="res_model">timesheet.weekly</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="timesheet_weekly_menu_parent" name="Emails" groups="hr_timesheet.group_hr_timesheet_approver" parent="hr_timesheet.menu_timesheets_reports" sequence="20" />
    <menuitem id="timesheet_weekly_menu" action="timesheet_weekly_action" groups="hr_timesheet.group_hr_timesheet_approver" parent="timesheet_weekly_menu_parent" sequence="10" />
    <menuitem id="timesheet_mail_menu" action="mail_mail_action" groups="hr_timesheet.group_hr_timesheet_approver" parent="timesheet_weekly_menu_parent" sequence="20" />
</odoo>