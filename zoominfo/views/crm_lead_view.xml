<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_crm" model="ir.ui.view">
        <field name="name">crm.lead.view.form.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='opportunity_partner']/field[@name='partner_id']" position="before">
                <field name="zoominfo_type" string="ZoomInfo Type"/>
                <label for="zoominfo_id" invisible="not zoominfo_type" string="Customer ID" />
                <div class="o_row" invisible="not zoominfo_type">
                    <field name="zoominfo_id" required="zoominfo_type" />
                    <button name="action_zoominfo" type="object" string="Import Info" help="Import Customer Info?" class="btn-link mb-1 px-0" icon="fa-refresh" />
                </div>
            </xpath>
        </field>
    </record>
</odoo>