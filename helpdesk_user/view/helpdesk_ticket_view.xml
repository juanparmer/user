<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_ticket_view_form_inherit_helpdesk_timesheet_helpdesk_timesheet"
        model="ir.ui.view">
        <field name="name">helpdesk.ticket.view.form.inherit</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id"
            ref="helpdesk_timesheet.helpdesk_ticket_view_form_inherit_helpdesk_timesheet" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='project_id'][1]" position="replace">
                <field name="project_id" invisible="0" />
                <field name="helpdesk_task_id" invisible="1" />
            </xpath>
            <xpath expr="//field[@name='timesheet_ids']" position="attributes">
                <attribute name="context">
                    {'default_project_id': project_id, 'default_task_id': helpdesk_task_id}
                </attribute>
            </xpath>
            <xpath expr="//field[@name='timesheet_ids']/tree/field[@name='task_id']" position="attributes">
                <attribute name="column_invisible">False</attribute>
            </xpath>
        </field>
    </record>
</odoo>